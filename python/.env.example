# LLM Configuration
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.minimax.chat/v1
ECOM_LLM_MODEL=MiniMax-M1

# Redis Feature Store（可选：默认 false 用内置演示数据即可跑通；
# 设为 true 时 UserProfileAgent 从 Redis 读实时行为特征）
ECOM_FEATURE_STORE_ENABLED=false
ECOM_REDIS_URL=redis://localhost:6379/0

# Milvus
ECOM_MILVUS_HOST=localhost
ECOM_MILVUS_PORT=19530

# Database
ECOM_DATABASE_URL=sqlite:///./ecommerce.db

# A/B Testing
ECOM_AB_TEST_ENABLED=true
